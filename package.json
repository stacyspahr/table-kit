{
  "name": "table-kit",
  "version": "0.9.0",
  "description": "Shared game-night layer for Stacy's table-game scorers: seats, joining, sync, resilience, PWA.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./roster": {
      "types": "./dist/roster.d.ts",
      "default": "./dist/roster.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "pocketbase": ">=0.26",
    "qrcode": ">=1.5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "jsdom": "^26.0.0",
    "pocketbase": "^0.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "UNLICENSED",
  "private": false
}
